# Единые переводы строк, чтобы собранный index.html не выглядел изменённым
# из-за разницы между Windows и раннером.
* text=auto eol=lf

# PowerShell на Windows дружелюбнее к CRLF — этот файл оставляем как есть.
*.ps1 text eol=crlf

# Картинки — двоичные, никакой обработки переводов строк.
*.png binary
*.jpg binary
*.gif binary
